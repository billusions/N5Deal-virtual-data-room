# Copy to .env and fill in. Never commit the real .env file.

# Deployed app under test
API_URL=https://virtual-data-room-production.up.railway.app
WEB_URL=https://virtual-data-room-ten.vercel.app

# README-documented shared test accounts (used only by the few tests that
# specifically need a stable, pre-existing account; everything else
# registers its own throwaway user per test run)
README_OWNER_EMAIL=john@example.com
README_OWNER_PASSWORD=johnpass
README_VIEWER_EMAIL=viewer@example.com
README_VIEWER_PASSWORD=viewerpass
