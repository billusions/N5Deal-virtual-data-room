{
  "name": "virtual-data-room-qa",
  "private": true,
  "version": "1.0.0",
  "description": "QA automation for the Virtual Data Room assignment (API + E2E, Playwright/TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:flaky-check": "playwright test --repeat-each=8",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
