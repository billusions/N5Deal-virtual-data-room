{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@support/*": ["src/support/*"]
    }
  },
  "include": ["specs/**/*.ts", "src/**/*.ts", "playwright.config.ts"]
}
